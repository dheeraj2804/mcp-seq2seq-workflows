# demo uses no credentials. Providers are opt-in per request.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# local or mcp; mcp starts the bundled stdio tool server
TOOL_TRANSPORT=local
PORT=5000

# Optional local AI, no API key
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Local semantic retrieval (keyword fallback if unavailable)
EMBEDDING_MODEL=all-minilm:22m
SEMANTIC_SEARCH=on
SEMANTIC_MIN_SIMILARITY=0.32
